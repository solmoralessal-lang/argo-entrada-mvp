# ==================================================
# ARGO Enterprise SaaS
# Archivos locales y generados
# ==================================================

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/

# Caché y bytecode de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
logs/
*.log

# Archivos generados por ARGO
outputs/
salidas/

# Respaldos locales
backups/

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db

# Editores e IDE
.vscode/
.idea/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de construcción temporales
build/
coverage/

# No ignorar el frontend compilado utilizado por ARGO
!dist/
!dist/**
