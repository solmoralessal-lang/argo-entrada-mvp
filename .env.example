# ==================================================
# ARGO Enterprise SaaS — Configuración de referencia
# NO colocar secretos reales en este archivo.
# ==================================================

# --------------------------------------------------
# OBLIGATORIAS — servicios externos
# --------------------------------------------------

OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# OBLIGATORIA — firma de sesiones
# Usar un valor largo, aleatorio y privado.
# --------------------------------------------------

ARGO_SESSION_SECRET=

# --------------------------------------------------
# CORS
# Separar múltiples orígenes con coma.
# En producción/piloto usar solamente dominios autorizados.
# --------------------------------------------------

ARGO_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# --------------------------------------------------
# SESIÓN
# Default actual: 8 horas
# --------------------------------------------------

ARGO_SESSION_TTL_SECONDS=28800

# --------------------------------------------------
# RATE LIMITING
# --------------------------------------------------

ARGO_RATE_LIMIT_WINDOW_SECONDS=60
ARGO_RATE_LIMIT_LOGIN=10
ARGO_RATE_LIMIT_OCR=30
ARGO_RATE_LIMIT_ADMIN=10

# --------------------------------------------------
# INFRAESTRUCTURA / HTTPS
# Activar únicamente cuando exista proxy confiable y HTTPS.
# --------------------------------------------------

ARGO_TRUST_PROXY_HEADERS=false
ARGO_HSTS_ENABLED=false

# --------------------------------------------------
# LÍMITES DEFENSIVOS DE JSON
# --------------------------------------------------

ARGO_JSON_MAX_BYTES=262144
ARGO_JSON_MAX_STRING_LENGTH=10000
ARGO_JSON_MAX_LIST_ITEMS=500
ARGO_JSON_MAX_OBJECT_KEYS=200
ARGO_JSON_MAX_DEPTH=10
